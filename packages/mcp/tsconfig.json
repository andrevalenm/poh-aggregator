{
  "compilerOptions": {
    // ESNext, matching the SDK: the ontology JSON is loaded with an import attribute
    // (`with { type: 'json' }`), which ES2022 does not admit.
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022"], "strict": true, "declaration": true,
    "outDir": "dist", "rootDir": "src", "skipLibCheck": true,
    "resolveJsonModule": true, "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true, "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts"]
}
