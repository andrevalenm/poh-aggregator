{
  "name": "@printid/mcp",
  "version": "0.1.2",
  "description": "MCP server exposing proof-of-personhood lookup across protocols, scored by independent trust root.",
  "type": "module",
  "bin": {
    "print-mcp": "./dist/server.js"
  },
  "main": "./dist/server.js",
  "files": [
    "dist",
    "dist/ontology-data.json",
    "README.md"
  ],
  "scripts": {
    "build": "cp ../../ontology/adapters.json src/ontology-data.json && tsc -p tsconfig.json && cp src/ontology-data.json dist/",
    "start": "node dist/server.js",
    "test": "npm run build && node --test 'test/**/*.test.mjs'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrevalenm/poh-aggregator.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/andrevalenm/poh-aggregator#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@printid/sdk": "^0.1.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "license": "MIT"
}
