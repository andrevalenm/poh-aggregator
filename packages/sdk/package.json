{
  "name": "@printid/sdk",
  "version": "0.1.2",
  "description": "Aggregate proof-of-personhood credentials across protocols, scored by independent trust root.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "proof-of-humanity",
    "proof-of-personhood",
    "sybil-resistance",
    "ens",
    "worldid",
    "identity"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrevalenm/poh-aggregator.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/andrevalenm/poh-aggregator#readme",
  "scripts": {
    "build": "cp ../../ontology/adapters.json src/ontology-data.json && cp ../../ontology/enrollment.json src/enrollment-data.json && tsc -p tsconfig.json && cp src/ontology-data.json src/enrollment-data.json dist/ && node scripts/fix-dts.mjs",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts'",
    "test:live": "LIVE=1 node --test --experimental-strip-types 'src/**/*.live.test.ts'"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
