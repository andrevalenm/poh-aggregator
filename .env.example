# Copy to .env.local and fill in. .env.local is gitignored.

# Deployer — burner wallet only, never a production key
DEPLOYER_PRIVATE_KEY=0x...
DEPLOYER_ADDRESS=0x...

# World Developer Portal (developer.worldcoin.org)
WORLD_DEVELOPER_API_KEY=api_...
WORLD_APP_ID=app_...
WORLD_TEAM_ID=team_...
WORLD_RP_ID=rp_...                # World ID 4.0 relying party
WORLD_SIGNER_ADDRESS=0x...
WORLD_SIGNER_PRIVATE_KEY=0x...    # returned once at RP creation, never again

# The Graph (thegraph.com/studio)
GRAPH_DEPLOY_KEY=
GRAPH_SUBGRAPH_SLUG=poh
GRAPH_NETWORK=gnosis              # subgraph indexes PoH + Circles on Gnosis

# Chains
REGISTRY_CHAIN=sepolia            # registry deploys here; ENS testnet is also Sepolia
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
GNOSIS_RPC_URL=https://rpc.gnosischain.com
WORLDCHAIN_RPC_URL=https://worldchain-mainnet.g.alchemy.com/public
BASE_RPC_URL=https://base-rpc.publicnode.com   # note: base.org 403s bots
